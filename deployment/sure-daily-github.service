[Unit]
Description=Sure Daily GitHub - Automated Issue Submission
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sure-daily-github
Environment="NODE_ENV=production"
ExecStart=/usr/bin/node /opt/sure-daily-github/src/cli.js start
Restart=always
RestartSec=10
StandardOutput=append:/opt/sure-daily-github/logs/systemd.log
StandardError=append:/opt/sure-daily-github/logs/systemd-error.log
SyslogIdentifier=sure-daily-github

# Resource limits
MemoryLimit=512M
MemoryAccounting=yes

# Timeout
TimeoutStartSec=30
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
