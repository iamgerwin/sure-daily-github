# GitHub Authentication
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Override config file path
CONFIG_PATH=./config/config.yaml

# Optional: Abort GitHub API requests that take longer than this (ms, default 30000)
# GITHUB_REQUEST_TIMEOUT_MS=30000

# Optional: Retries for rate-limited requests (REST and GraphQL) and transient read failures (default 2, 0 disables)
# GITHUB_REQUEST_RETRIES=2

# Logging
# One of error, warn, info, debug (debug adds per-step detail; unknown values fall back to info)
LOG_LEVEL=info
# Optional: Console output is colored only on a terminal; set to disable it there too
# NO_COLOR=1
