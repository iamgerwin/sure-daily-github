# GitHub Authentication
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Override config file path
CONFIG_PATH=./config/config.yaml

# Optional: Abort GitHub API requests that take longer than this (ms, default 30000)
# GITHUB_REQUEST_TIMEOUT_MS=30000

# Logging
LOG_LEVEL=info

# Optional: Debug mode
# DEBUG=sure-daily-github:*
